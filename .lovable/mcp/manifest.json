            "project_type": {
              "description": "Filter by project type, e.g. Bath, Kitchen, Full Rehab.",
              "type": "string"
            },
            "search": {
              "description": "Case-insensitive match on the item description.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
